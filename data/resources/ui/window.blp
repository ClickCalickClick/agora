using Gtk 4.0;
using Adw 1;

template $AgoraWindow: Adw.ApplicationWindow {
  width-request: 360;
  height-request: 360;
  title: _("Agora");

  Adw.Breakpoint {
    condition ("max-width: 1099sp")

    setters {
      outer.collapsed: true;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 699sp")

    setters {
      outer.collapsed: true;
      inner.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toasts {
    Gtk.Box {
      orientation: vertical;

      Adw.Banner banner {
        button-clicked => $on_banner_button() swapped;
      }

      Gtk.Stack content_stack {
        vexpand: true;
        transition-type: crossfade;

        Gtk.StackPage {
          name: "main";

          child: Adw.OverlaySplitView outer {
            min-sidebar-width: 220;
            max-sidebar-width: 280;
            sidebar-width-fraction: 0.2;

            sidebar: Adw.NavigationPage {
              title: _("Agora");
              tag: "sidebar";

              child: $AgoraSidebar sidebar {};
            };

            content: Adw.NavigationSplitView inner {
              min-sidebar-width: 340;
              max-sidebar-width: 460;
              sidebar-width-fraction: 0.4;

              sidebar: $AgoraFeedPage feed_page {};

              content: $AgoraPostPage post_page {};
            };
          };
        }

        Gtk.StackPage {
          name: "sign-in";

          child: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {}

            content: Adw.StatusPage {
              icon-name: "avatar-default-symbolic";
              title: _("Sign In to Reddit");
              description: _("Agora shows Reddit through your own account");

              child: Gtk.Button {
                halign: center;
                label: _("_Sign In");
                use-underline: true;
                action-name: "win.sign-in";

                styles [
                  "pill",
                  "suggested-action",
                ]
              };
            };
          };
        }
      }
    }
  };
}
