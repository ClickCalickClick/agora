using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("Reading");

    Adw.ShortcutsItem {
      title: _("Next Post or Comment");
      accelerator: "j";
    }

    Adw.ShortcutsItem {
      title: _("Previous Post or Comment");
      accelerator: "k";
    }

    Adw.ShortcutsItem {
      title: _("Open Selected Post");
      accelerator: "Return o";
    }

    Adw.ShortcutsItem {
      title: _("Collapse or Expand Comment");
      accelerator: "space";
    }

    Adw.ShortcutsItem {
      title: _("Back");
      accelerator: "h <Alt>Left";
    }

    Adw.ShortcutsItem {
      title: _("Upvote");
      accelerator: "a";
    }

    Adw.ShortcutsItem {
      title: _("Downvote");
      accelerator: "z";
    }

    Adw.ShortcutsItem {
      title: _("Save");
      accelerator: "s";
    }

    Adw.ShortcutsItem {
      title: _("Refresh");
      accelerator: "F5 <Control>r";
    }
  }

  Adw.ShortcutsSection {
    title: _("View");

    Adw.ShortcutsItem {
      title: _("Toggle Sidebar");
      accelerator: "F9";
    }

    Adw.ShortcutsItem {
      title: _("Larger Text");
      accelerator: "<Control>plus";
    }

    Adw.ShortcutsItem {
      title: _("Smaller Text");
      accelerator: "<Control>minus";
    }

    Adw.ShortcutsItem {
      title: _("Reset Text Size");
      accelerator: "<Control>0";
    }
  }

  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      accelerator: "<Control>question";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      accelerator: "<Control>w";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      accelerator: "<Control>q";
    }
  }
}
