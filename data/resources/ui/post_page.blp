using Gtk 4.0;
using Adw 1;

template $AgoraPostPage: Adw.NavigationPage {
  title: _("Post");
  tag: "post";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-title: false;

      [end]
      Gtk.MenuButton overflow_button {
        icon-name: "view-more-symbolic";
        tooltip-text: _("More Options");
        menu-model: overflow_menu;
      }

      [end]
      Gtk.MenuButton sort_button {
        icon-name: "view-sort-descending-symbolic";
        tooltip-text: _("Sort Comments");
        menu-model: sort_menu;
      }
    }

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage {
          icon-name: "agora-comments-symbolic";
          title: _("No Post Selected");
          description: _("Pick a post to read it and its comments");
        };
      }

      Gtk.StackPage {
        name: "content";

        child: Gtk.ScrolledWindow scroller {
          hscrollbar-policy: never;

          child: Adw.ClampScrollable {
            maximum-size: 860;
            tightening-threshold: 600;

            child: Gtk.ListView list_view {
              tab-behavior: item;
              activate => $on_activate() swapped;

              accessibility {
                label: _("Comments");
              }

              styles [
                "comment-list",
              ]
            };
          };
        };
      }
    };
  };
}

menu overflow_menu {
  section {
    item {
      label: _("_Copy Link");
      action: "post.copy-link";
    }

    item {
      label: _("_Open in Browser");
      action: "post.open-in-browser";
    }
  }
}

menu sort_menu {
  section {
    item {
      label: _("_Best");
      action: "post.sort";
      target: "best";
    }

    item {
      label: _("_Top");
      action: "post.sort";
      target: "top";
    }

    item {
      label: _("_New");
      action: "post.sort";
      target: "new";
    }

    item {
      label: _("_Controversial");
      action: "post.sort";
      target: "controversial";
    }

    item {
      label: _("_Old");
      action: "post.sort";
      target: "old";
    }

    item {
      label: _("_Q&A");
      action: "post.sort";
      target: "qa";
    }
  }
}
